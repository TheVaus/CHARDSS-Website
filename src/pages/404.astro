---
import Base from "../layouts/Base.astro";
import { url } from "../lib/content";
---
<Base title="Page not found">
  <div class="wrap nf">
    <h1>That square is empty.</h1>
    <p>The page you were looking for isn't here. It may have been moved or renamed.</p>
    <p><a class="btn btn--brass" href={url()}>Back to the home page</a></p>
  </div>
</Base>
<style>.nf { padding: clamp(3rem, 10vw, 8rem) 0; }</style>
