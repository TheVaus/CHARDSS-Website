---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import { cards, url, asset, plainText, cardText } from "../lib/content";

// Server-rendered opening hand (the script deals a random one in the browser)
const opening = ["teleport", "mimic", "armageddon"].map((s) => cards.find((c) => c.slug === s)!);
const handData = cards.map((c) => ({ slug: c.slug, img: asset(c.image), alt: `${c.name}, cost ${c.cost}: ${plainText(c.text)}` }));
const featured = cards.find((c) => c.slug === "teleport")!;

const values = [
  { piece: "Pawn", pts: 1 },
  { piece: "Knight", pts: 3 },
  { piece: "Bishop", pts: 3 },
  { piece: "Rook", pts: 5 },
  { piece: "Queen", pts: 9 },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="motto"><span>Chess,</span> <span>Cards,</span> <span>Chaos.</span></h1>
        <p class="lede">CHARDSS adds a shared deck of 40 cards to an ordinary game of chess. Every piece you lose earns you points. Spend them on cards that bend the rules: teleport your <span class="piece" role="img" aria-label="King">{"{King}"}</span>, march your <span class="piece" role="img" aria-label="Pawn">{"{Pawn}"}</span>s like knights, or force your opponent to take back their last move.</p>
        <div class="actions">
          <a class="btn btn--brass" href={url("rules/")}>Read the rules</a>
          <a class="btn" href={url("cards/")}>See all 40 cards</a>
        </div>
      </div>

      <div class="table">
        <img class="deck card-img" src={asset("card-back.webp")} alt="" width="600" height="838" />
        <ol class="hand" id="hand" aria-label="An opening hand of three cards">
          {opening.map((c, i) => (
            <li style={`--i:${i}`}>
              <a href={url(`cards/${c.slug}/`)}>
                <img class="card-img" src={asset(c.image)} alt={`${c.name}, cost ${c.cost}: ${plainText(c.text)}`} width="600" height="838" />
              </a>
            </li>
          ))}
        </ol>
        <button class="redeal" id="redeal" type="button">Draw a new hand</button>
      </div>
    </div>
  </section>

  <section class="board" aria-label="How CHARDSS plays">
    <div class="wrap squares">
      <div class="square parchment">
        <h2>Your turn, in order</h2>
        <ol class="steps">
          <li><h3>Play a card</h3><p>Optional, one per turn. Pay its cost in points, then put it on the shared discard pile.</p></li>
          <li><h3>Make your move</h3><p>A normal legal chess move, unless the card you just played says otherwise.</p></li>
          <li><h3>Draw back to three</h3><p>Refill your hidden hand from the shared deck. When the deck runs out, keep playing chess.</p></li>
        </ol>
      </div>
      <div class="square walnut">
        <h2>Your losses pay for your cards</h2>
        <p>When one of your pieces is captured, you gain its value in points. Taking your opponent's pieces earns you nothing.</p>
        <ul class="values">
          {values.map((v) => (
            <li>
              <span class="piece big" role="img" aria-label={v.piece}>{`{${v.piece}}`}</span>
              <span class="pts">{v.pts}</span>
              <span class="name">{v.piece}</span>
            </li>
          ))}
        </ul>
        <p class="note">If a card contradicts a rule of chess, the card wins. It still can't leave the board in an illegal position.</p>
      </div>
    </div>
  </section>

  <section class="showcase wrap" aria-labelledby="showcase-title">
    <div class="showcase-copy">
      <h2 id="showcase-title">Every card, played out on the board</h2>
      <p>Each card in the deck comes with a short demo of what it does to a real position. Here's <a href={url(`cards/${featured.slug}/`)}>{featured.name}</a>:</p>
      <a class="feature-card" href={url(`cards/${featured.slug}/`)}>
        <img class="card-img" src={asset(featured.image)} alt={`${featured.name}, cost ${featured.cost}: ${plainText(featured.text)}`} width="600" height="838" loading="lazy" />
      </a>
      <p class="feature-text" set:html={cardText(featured.text)} />
      <a class="btn" href={url("cards/")}>Browse the deck</a>
    </div>
    <Demo slug={featured.slug} name={featured.name} cost={featured.cost} compact />
  </section>

  <script define:vars={{ handData, base: url("cards/") }}>
    const hand = document.getElementById("hand");
    const btn = document.getElementById("redeal");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const esc = (s) => s.replace(/&/g, "&amp;").replace(/"/g, "&quot;");

    function deal() {
      const pool = [...handData];
      const picks = [];
      while (picks.length < 3) picks.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
      hand.innerHTML = picks.map((c, i) =>
        `<li style="--i:${i}"><a href="${base}${c.slug}/"><img class="card-img" src="${c.img}" alt="${esc(c.alt)}" width="600" height="838"></a></li>`
      ).join("");
      if (!reduce) {
        hand.classList.remove("dealing");
        void hand.offsetWidth; // restart the animation
        hand.classList.add("dealing");
      }
    }
    btn.addEventListener("click", deal);
    deal();
  </script>
</Base>

<style>
  .hero { padding: clamp(2.5rem, 7vw, 6rem) 0 clamp(3rem, 8vw, 7rem); overflow: hidden; }
  .hero-grid > * { min-width: 0; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }

  /* The motto: three words, each on its own line, set like the card names */
  .motto { font-size: clamp(3.4rem, 9vw, 7rem); line-height: 0.92; margin-bottom: 0.45em; letter-spacing: -0.005em; }
  .motto span { display: block; }
  .motto span:nth-child(2) { padding-left: 0.55em; color: var(--parchment); }
  .motto span:nth-child(3) { padding-left: 1.1em; color: var(--brass); }

  .lede { font-size: 1.2rem; line-height: 1.65; }
  .lede .piece { color: var(--parchment-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }

  /* The table: deck on the left, fanned hand dealt from it */
  .table { position: relative; aspect-ratio: 1 / 0.8; min-height: 300px; }
  .deck { position: absolute; left: 0; top: 12%; width: 31%; }
  .hand { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; }
  .hand :global(li) {
    position: absolute; width: 35%; left: 45%; top: 4%;
    transform-origin: 50% 140%;
    transform: rotate(calc((var(--i) - 1) * 9deg)) translateX(calc((var(--i) - 1) * 38%));
    transition: transform 0.25s ease;
  }
  .hand :global(li:hover), .hand :global(li:focus-within) { transform: rotate(calc((var(--i) - 1) * 9deg)) translateX(calc((var(--i) - 1) * 38%)) translateY(-6%); z-index: 2; }
  .hand.dealing :global(li) { animation: deal 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) backwards; animation-delay: calc(var(--i) * 0.12s); }
  @keyframes deal { from { transform: translateX(-110%) translateY(6%) rotate(-8deg); } }
  .redeal {
    position: absolute; left: 0; bottom: 0;
    font: 500 1.2rem/1 var(--display); color: var(--dust);
    background: none; border: 0; padding: 0.4rem 0; cursor: pointer;
    border-bottom: 1px solid var(--walnut-2);
  }
  .redeal:hover { color: var(--parchment-2); border-bottom-color: var(--brass); }

  /* Two squares of the board, like the quadrants on the card back */
  .board { padding: 0 0 clamp(4rem, 9vw, 7rem); }
  .squares { display: grid; grid-template-columns: 1fr 1fr; }
  .square { padding: clamp(1.75rem, 4.5vw, 3.5rem); }
  .steps { list-style: none; counter-reset: step; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 1.4rem; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 3rem 1fr; column-gap: 1rem; }
  .steps li::before { content: counter(step); grid-row: span 2; font: 500 2.6rem/0.9 var(--display); color: var(--walnut); }
  .steps h3 { margin: 0 0 0.2rem; color: var(--ink); }
  .steps p { margin: 0; }
  .values { list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem; padding: 0; margin: 1.75rem 0; text-align: center; }
  .values li { display: grid; gap: 0.15rem; justify-items: center; padding: 0.9rem 0.25rem; background: var(--ebony); }
  .piece.big { font-size: 2.6rem; }
  .pts { font: 600 1.9rem/1 var(--display); color: var(--brass); }
  .name { font-size: var(--s-1); color: var(--dust); }
  .note { font-size: 0.98rem; margin: 0; }

  /* Showcase: a card next to its board demo */
  .showcase { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 560px); justify-content: space-between; gap: clamp(2rem, 6vw, 5.5rem); align-items: start; }
  .showcase-copy { display: grid; grid-template-columns: 9rem 1fr; column-gap: 1.5rem; align-items: start; }
  .showcase-copy > h2, .showcase-copy > p:first-of-type { grid-column: 1 / -1; }
  .feature-card { grid-row: span 2; }
  .feature-text { font: 400 1.5rem/1.35 var(--display); color: var(--parchment-2); margin-top: 0.25rem; }
  .showcase-copy .btn { justify-self: start; align-self: end; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .table { max-width: 520px; width: 100%; margin-inline: auto; aspect-ratio: 1 / 0.7; }
    .squares { grid-template-columns: 1fr; }
    .showcase { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 480px) {
    .values { gap: 0.3rem; }
    .piece.big { font-size: 2rem; }
    .showcase-copy { grid-template-columns: 6.5rem 1fr; column-gap: 1rem; }
    .feature-text { font-size: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hand :global(li) { transition: none; }
  }
</style>
