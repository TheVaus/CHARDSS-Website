---
import Base from "../../layouts/Base.astro";
import { cards, url, asset, plainText } from "../../lib/content";
---
<Base title="Cards" description="All 40 CHARDSS cards, each with an animated board demo of what it does.">
  <div class="wrap">
    <header class="head">
      <h1 class="diagonal"><span>Forty cards,</span> <span>one shared deck.</span></h1>
      <p>Each card costs the points in its diamond, earned when your own pieces are captured. Open a card to watch it played out on the board.</p>
    </header>

    <ul class="grid files">
      {cards.map((c) => (
        <li>
          <a href={url(`cards/${c.slug}/`)}>
            <img class="card-img" src={asset(c.image)} alt={`${c.name}, cost ${c.cost}: ${plainText(c.text)}`} width="600" height="838" loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .head { padding: clamp(2rem, 5vw, 4rem) 0 2.5rem; }
  .head h1 { line-height: 1; }
  .head h1 > span:nth-child(2) { margin-left: 1em; }
  .grid { list-style: none; padding: 0; margin: 0; gap: clamp(0.75rem, 1.6vw, 1.5rem) clamp(0.5rem, 1.4vw, 1.25rem); }
  .grid a { display: block; }
  .grid img { transition: transform 0.18s; }
  .grid a:hover img { transform: translateY(-6px) rotate(-1.2deg); }
  .grid a:focus-visible { outline-offset: 6px; }
  @media (prefers-reduced-motion: reduce) { .grid img { transition: none; } }
</style>
