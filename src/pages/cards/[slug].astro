---
import Base from "../../layouts/Base.astro";
import Demo from "../../components/Demo.astro";
import Tray from "../../components/Tray.astro";
import { cards, url, asset, cardText, plainText, type Card } from "../../lib/content";

export function getStaticPaths() {
  return cards.map((card, i) => ({
    params: { slug: card.slug },
    props: { card, prev: cards[(i - 1 + cards.length) % cards.length], next: cards[(i + 1) % cards.length] },
  }));
}
interface Props { card: Card; prev: Card; next: Card }
const { card, prev, next } = Astro.props;

// What the cost looks like in lost pieces (fewest pieces that add up to it)
const pay: string[] = [];
let left = card.cost;
for (const [p, v] of [["Queen", 9], ["Rook", 5], ["Knight", 3], ["Pawn", 1]] as const) while (left >= v) { pay.push(p); left -= v; }
const said = (() => {
  const counts = pay.reduce<Record<string, number>>((m, p) => ((m[p] = (m[p] ?? 0) + 1), m), {});
  const words = ["", "a", "two", "three", "four"];
  const parts = Object.entries(counts).map(([p, n]) => (n === 1 ? `a ${p}` : `${words[n]} ${p}s`));
  return parts.length > 1 ? `${parts.slice(0, -1).join(", ")} and ${parts.at(-1)}` : parts[0];
})();
---
<Base title={card.name} description={`${card.name} (cost ${card.cost}): ${plainText(card.text)}`} image={asset(card.image)}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url("cards/")}>All cards</a></nav>
    <article class="layout">
      <div class="side">
        <img class="face card-img" src={asset(card.image)} alt={`${card.name} card: ${plainText(card.text)}`} width="600" height="838" />
        <p class="links">
          <a href={asset(card.image_full)} download>Download print-size PNG</a>
        </p>
      </div>
      <div class="main">
        <p class="num">Card {card.id} of {cards.length}</p>
        <h1>{card.name}</h1>
        {card.cost === 0 ? (
          <div class="cost"><span class="diamond"><span>0</span></span><span>Free to play</span></div>
        ) : (
          <div class="cost">
            <Tray pieces={pay} label="Lost pieces worth the same" total={card.cost} />
            <span>Costs {card.cost} {card.cost === 1 ? "point" : "points"}: as much as losing {said}.</span>
          </div>
        )}
        <p class="effect" set:html={cardText(card.text)} />
        <h2 class="demo-title">On the board</h2>
        <Demo slug={card.slug} name={card.name} cost={card.cost} />
      </div>
    </article>
    <nav class="pager" aria-label="More cards">
      <a href={url(`cards/${prev.slug}/`)} rel="prev"><span class="dir">Previous</span>{prev.name}</a>
      <a href={url(`cards/${next.slug}/`)} rel="next"><span class="dir">Next</span>{next.name}</a>
    </nav>
  </div>
</Base>

<style>
  .crumbs { padding: 1.5rem 0 1rem; }
  .layout { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); column-gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .side { grid-column: 1 / 4; }
  .main { grid-column: 4 / 9; }
  .side { position: sticky; top: 90px; }
  .links { margin-top: 1.25rem; }
  .num { font-size: var(--s-1); margin-bottom: 0.4rem; }
  .cost { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin: 0.75rem 0 1.75rem; font-size: 1.1rem; }
  .cost .diamond { font-size: 1.15rem; margin-left: 0.4rem; }
  .effect {
    font: 400 clamp(1.5rem, 2.4vw, 1.95rem)/1.35 var(--display);
    color: var(--parchment-2);
    max-width: 30ch;
  }
  .demo-title { font-size: var(--s2); margin: 2.5rem 0 1rem; }
  .main :global(.demo) { max-width: 640px; }
  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--ebony-2); }
  .pager a { display: grid; text-decoration: none; font: 500 1.5rem/1.2 var(--display); color: var(--parchment-2); }
  .pager a[rel="next"] { text-align: right; }
  .pager .dir { font: 400 var(--s-1)/1.4 var(--body); color: var(--dust); }
  .pager a:hover { color: var(--brass); }
  @media (max-width: 760px) {
    .layout { grid-template-columns: 1fr; }
    .side, .main { grid-column: 1 / -1; }
    .side { position: static; display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; align-items: end; }
    .links { margin: 0; }
  }
</style>
