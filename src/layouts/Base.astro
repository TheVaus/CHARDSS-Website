---
import "@fontsource/alegreya-sans/400.css";
import "@fontsource/alegreya-sans/400-italic.css";
import "@fontsource/alegreya-sans/500.css";
import "@fontsource/alegreya-sans/700.css";
import "../styles/global.css";
import { url, asset } from "../lib/content";

interface Props { title?: string; description?: string; image?: string }
const { title, description = "CHARDSS is chess with a shared deck of 40 rule-bending cards. Lose pieces, earn points, spend them to break the rules.", image } = Astro.props;
const fullTitle = title ? `${title} | CHARDSS` : "CHARDSS: Chess, Cards, Chaos";
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const nav = [
  { href: "", label: "Home", match: (p: string) => p === "/" },
  { href: "rules/", label: "Rules", match: (p: string) => p.startsWith("/rules") },
  { href: "cards/", label: "Cards", match: (p: string) => p.startsWith("/cards") },
  { href: "design/", label: "Design notes", match: (p: string) => p.startsWith("/design") },
  { href: "contact/", label: "Contact", match: (p: string) => p.startsWith("/contact") },
];
const ogImage = new URL(image ?? asset("card-back-large.webp"), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e140e" />
    <link rel="icon" type="image/png" href={asset("logo-180.png")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:inline set:html={`@font-face{font-family:"Chardss Display";src:url("${asset("fonts/ChardssDisplay-Regular.woff2")}") format("woff2");font-display:swap}`}></style>
    <link rel="preload" as="font" type="font/woff2" crossorigin href={asset("fonts/ChardssDisplay-Regular.woff2")} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url()} aria-label="CHARDSS home">
          <img src={asset("logo.webp")} alt="" width="44" height="44" />
          <span>CHARDSS</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={url(n.href)} aria-current={n.match(path) ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <img src={asset("logo.webp")} alt="" width="56" height="56" loading="lazy" />
          <p><strong>CHARDSS</strong><br />Chess, Cards, Chaos.</p>
        </div>
        <nav aria-label="Footer">
          <ul>
            {nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="credits">
          <p>Game and card design by Daniel Vekar.</p>
          <p class="small">Set in CHARDSS Display, a modified <a href="https://github.com/CatharsisFonts/Cormorant">Cormorant</a> (<a href={asset("fonts/OFL.txt")}>SIL OFL</a>). Chess pieces by Colin M.L. Burnett (Cburnett).</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--ebony) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--ebony-2);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 1rem; }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--parchment-2); }
  .brand span { font: 500 1.5rem/1 var(--display); letter-spacing: 0.06em; }
  nav ul { display: flex; gap: clamp(0.75rem, 3vw, 2rem); list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--dust); text-decoration: none; font: 500 1.3rem/1 var(--display); padding: 0.4rem 0; border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--parchment-2); }
  nav a[aria-current="page"] { color: var(--parchment-2); border-bottom-color: var(--brass); }
  .site-footer { border-top: 1px solid var(--ebony-2); margin-top: 7rem; padding: 3rem 0 3.5rem; background: var(--grain), var(--walnut); }
  .site-footer a { color: var(--parchment-2); }
  .foot { display: grid; grid-template-columns: 1.2fr 1fr 1.6fr; gap: 2rem; align-items: start; }
  .foot p { margin: 0 0 0.4rem; }
  .foot-brand { display: flex; gap: 0.9rem; align-items: center; }
  .foot-brand strong { font: 500 1.5rem/1 var(--display); color: var(--parchment-2); letter-spacing: 0.03em; }
  .foot-brand p { font-family: var(--display); font-size: 1.15rem; line-height: 1.25; margin: 0; }
  .foot nav ul { display: grid; gap: 0.35rem; }
  .foot nav a { font-size: 1.15rem; }
  .small { font-size: var(--s-1); opacity: 0.85; }
  @media (max-width: 760px) { .foot { grid-template-columns: 1fr; } }
  @media (max-width: 480px) {
    .brand span { display: none; }
    nav ul { gap: 1rem; }
    nav a { font-size: 1.15rem; }
  }
</style>
